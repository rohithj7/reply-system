# Copy to .env (git-ignored) or export these in your shell. Never commit real values.

# Required: an OpenAI-compatible chat endpoint and a fixed model ID. These are the served
# endpoint and its writer model; set MODEL_API_KEY to the key you were sent.
MODEL_BASE_URL=https://31ixwh7mttywgt-8001.proxy.runpod.net/v1
MODEL_API_KEY=replace-me
MODEL_ID=Qwen/Qwen3.8-27B

# The served controller, for `--system modular`. Leave it unset to use MODEL_ID in both roles.
CONTROLLER_MODEL_ID=f100-e2

# Optional knobs (defaults shown).
# MODEL_TIMEOUT_SECONDS=60
# MODEL_MAX_RETRIES=3
# MODEL_STRUCTURED_OUTPUT=json_schema   # or json_object
# MODEL_TEMPERATURE=
# Sent as `reasoning_effort` when set: none, minimal, low, medium, high, xhigh or max.
# Some reasoning models need `none` for tool calling through Chat Completions.
# MODEL_REASONING_EFFORT=none

# Optional: another model at the same endpoint for the modular system's writer calls.
# It defaults to MODEL_ID; the baseline always uses MODEL_ID.
# WRITER_MODEL_ID=

# Optional: an evaluation-only judge (`eval --judge`), a different model from MODEL_ID,
# CONTROLLER_MODEL_ID and WRITER_MODEL_ID.
# JUDGE_BASE_URL=https://your-endpoint.example/v1
# JUDGE_API_KEY=replace-me
# JUDGE_MODEL_ID=replace-me
