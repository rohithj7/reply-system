{
  "$defs": {
    "EscalationChoice": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "human_requested",
            "unsupported_payment_action",
            "unsupported_money_movement",
            "unsupported_clinic_contact",
            "unsupported_date_hold",
            "unsupported_booking_change",
            "unsupported_document_action",
            "unsupported_other"
          ],
          "title": "Code",
          "type": "string"
        },
        "reason": {
          "description": "12 words or fewer, no digits: what the patient asked for.",
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "code",
        "reason"
      ],
      "title": "EscalationChoice",
      "type": "object"
    },
    "EscalationReview": {
      "additionalProperties": false,
      "properties": {
        "needed": {
          "title": "Needed",
          "type": "boolean"
        },
        "why": {
          "maxLength": 200,
          "title": "Why",
          "type": "string"
        }
      },
      "required": [
        "needed",
        "why"
      ],
      "title": "EscalationReview",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The decide step once the tool budget is spent: no more calls or skills.",
  "properties": {
    "escalation_review": {
      "anyOf": [
        {
          "$ref": "#/$defs/EscalationReview"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "next": {
      "enum": [
        "answer",
        "clarify",
        "escalate"
      ],
      "title": "Next",
      "type": "string"
    },
    "escalation": {
      "anyOf": [
        {
          "$ref": "#/$defs/EscalationChoice"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "next"
  ],
  "title": "FinalDecision",
  "type": "object"
}
